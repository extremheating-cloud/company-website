// Cloudflare Workers Static Assets config.
//
// The project was created as a Worker rather than a Pages project, so the deploy step
// is `npx wrangler deploy` and it needs this file to know what to serve. Without it
// wrangler has nothing to deploy and the build fails after the build command runs.
//
// There is no "main" entry on purpose. With `assets` and no Worker script, Cloudflare
// serves the directory directly from its edge — no Worker invocation per request, so
// nothing to pay for per request and nothing that can throw a runtime error.
//
// `site/` is generated by `python3 builder/build_site.py` and is gitignored, so it
// exists only inside the build container. That is the correct order: install, build,
// deploy.
//
// _headers and _redirects are read from inside the assets directory, the same as they
// are on Pages, so the 169 redirects and the cache policy carry over unchanged.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company-website",

  // Any date in the past is fine for a static site; it is pinned rather than floating
  // so a future runtime change cannot alter behaviour without someone choosing it.
  "compatibility_date": "2026-08-03",

  "assets": {
    "directory": "./site",

    // We generate a real 404 page. "none" would return a bare Cloudflare error, and
    // "single-page-application" would serve index.html for every unmatched path, which
    // on a 320-page static site means every typo returns the homepage with a 200 and
    // Google indexes duplicates of it.
    "not_found_handling": "404-page"
  }
}
